<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#FFB300"
    android:backgroundTint="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/circle_shape">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_limit_warning"
                android:contentDescription="Limit Reached" />
        </FrameLayout>

        <TextView
            android:id="@+id/txt_limit_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اتمام سهمیه ۲۰ تحلیل امروز"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/txt_limit_dialog_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="سقف مجاز ۲۰ تحلیل هوش مصنوعی برای امروز شما تکمیل شده است. به منظور تضمین کیفیت و منابع سرور، سهمیه روزانه شما بامداد فردا مجدداً به ۲۰ تحلیل کامل شارژ خواهد شد."
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:textColor="@color/secondaryTextColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:gravity="center"
            android:background="#12FFB300">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ زمان بازنشانی: بامداد فردا (ساعت ۰۰:۰۰)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFB300" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_limit_dialog_ok"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="متوجه شدم"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:backgroundTint="#FFB300"
            android:textColor="#000000" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
