<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Official Gateway Header -->
            <LinearLayout
                android:id="@+id/layout_header_shaparak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0D47A1"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/img_gateway_logo"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_shaparak"
                        android:contentDescription="Gateway" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_gateway_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="درگاه پرداخت اینترنتی شاپرک"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/txt_gateway_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="شبکه الکترونیکی پرداخت کارتی (شتاب) • زرین‌پال"
                            android:textSize="11sp"
                            android:textColor="#B0BEC5" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_shetab"
                        android:contentDescription="Shetab" />
                </LinearLayout>

                <!-- Amount Box inside Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:background="#1565C0"
                    android:padding="10dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/txt_dialog_amount_rials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="۴,۹۰۰,۰۰۰ ریال"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFD54F" />

                    <TextView
                        android:id="@+id/txt_dialog_amount_tomans"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="معادل ۴۹۰,۰۰۰ تومان"
                        android:textSize="13sp"
                        android:textColor="#E0E0E0" />
                </LinearLayout>

            </LinearLayout>

            <!-- Invoice Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="#08000000">

                <TextView
                    android:id="@+id/txt_merchant_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="پذیرنده: کریپتوپدیا VIP"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/txt_invoice_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="شماره فاکتور: CP-7842"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Card Inputs Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Detected Bank Name Badge -->
                <TextView
                    android:id="@+id/txt_detected_bank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="کارت بانکی عضو شبکه شتاب"
                    android:textSize="12sp"
                    android:textColor="@color/colorBuy"
                    android:textStyle="bold" />

                <!-- Card Number Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_card_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="شماره کارت (۱۶ رقم)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_card_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="19"
                        android:letterSpacing="0.1"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CVV2 & Expiry Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_cvv2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="CVV2"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_cvv2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberPassword"
                            android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="match_parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_exp_month"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="ماه انقضا"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_exp_month"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="match_parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_exp_year"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="سال انقضا"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_exp_year"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Dynamic Password (رمز پویا) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_dynamic_pin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="رمز دوم پویا"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_dynamic_pin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberPassword"
                            android:maxLength="8" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_request_dynamic_pin"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginStart="8dp"
                        android:text="دریافت رمز پویا"
                        android:textSize="12sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Security Captcha Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_captcha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="کد امنیتی"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_captcha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txt_captcha_code"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="84926"
                        android:textSize="20sp"
                        android:textStyle="bold|italic"
                        android:letterSpacing="0.2"
                        android:textColor="#37474F"
                        android:background="#ECEFF1" />
                </LinearLayout>

                <!-- Action Buttons: Pay and Cancel -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_dialog_pay"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="پرداخت اینترنتی و تایید نهایی"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_dialog_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:text="انصراف از پرداخت"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="@color/secondaryTextColor" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.cardview.widget.CardView>
